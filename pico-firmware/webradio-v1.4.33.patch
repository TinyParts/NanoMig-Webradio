+/* ---- audio samples for the internet radio (command 11) ---- */
+#define SPI_SYS_AUDIO        11
+#define SPI_SYS_AUDIO_STATUS  0
+#define SPI_SYS_AUDIO_PUT     1
+
+uint16_t sys_audio_space(void) {
+  sys_begin(SPI_SYS_AUDIO);
+  mcu_hw_spi_tx_u08(SPI_SYS_AUDIO_STATUS);
+  uint8_t hi = mcu_hw_spi_tx_u08(0);
+  uint8_t lo = mcu_hw_spi_tx_u08(0);
+  mcu_hw_spi_end();
+  return ((hi & 0x0f) << 8) | lo;
+}
+
+// send frames of left/right 16 bit samples, big endian (left hi/lo, right hi/lo)
+void sys_audio_write(const int16_t *lr, int frames) {
+  uint8_t buf[512];
+  while(frames > 0) {
+    int n = (frames > 128) ? 128 : frames;
+    for(int i=0;i<2*n;i++) {
+      buf[2*i]   = ((uint16_t)lr[i]) >> 8;
+      buf[2*i+1] = ((uint16_t)lr[i]) & 0xff;
+    }
+    sys_begin(SPI_SYS_AUDIO);
+    mcu_hw_spi_tx_u08(SPI_SYS_AUDIO_PUT);
+    mcu_hw_spi_tx_buffer(buf, 4*n);
+    mcu_hw_spi_end();
+    lr += 2*n;
+    frames -= n;
+  }
+}
+
 static void sys_port_begin(unsigned char cmd) {
   sys_begin(SPI_SYS_PORT);
   mcu_hw_spi_tx_u08(cmd); 
@@ -152,6 +184,33 @@ void sys_port_write(unsigned char port, const unsigned char *ptr, int len) {
