 static void port_putc(unsigned char byte) {
   at_wifi_escape_tick = xTaskGetTickCount();  // reset idle counter
+  if(out_mutex) xSemaphoreTake(out_mutex, portMAX_DELAY);
   sys_port_write(0, &byte, 1);
+  if(out_mutex) xSemaphoreGive(out_mutex);
+}
+
+// unsolicited text (radio status): the core's fifo towards the Amiga is tiny (15 bytes), so
+// longer lines go out piece by piece while the Amiga reads. The output lock is held for the
+// whole line so lines from different tasks do not mix. Gives up after timeout_ms (nobody reading).
+bool at_wifi_puts_wait(const char *str, unsigned int timeout_ms) {
+  if(!out_mutex) return false;
+  const unsigned char *p = (const unsigned char *)str;
+  int len = strlen(str);
+  TickType_t start = xTaskGetTickCount();
+  bool ok = true;
+  xSemaphoreTake(out_mutex, portMAX_DELAY);
+  while(len > 0) {
+    int n = sys_port_write_part(0, p, len);
+    if(n > 0) { p += n; len -= n; continue; }
+    if((xTaskGetTickCount() - start) > pdMS_TO_TICKS(timeout_ms)) { ok = false; break; }
+    vTaskDelay(pdMS_TO_TICKS(1));
+  }
+  xSemaphoreGive(out_mutex);
+  return ok;
+}
+
+// unsolicited text (radio status): never waits for the Amiga to read
+bool at_wifi_puts_nb(const char *str) {
+  if(!out_mutex) return false;
+  xSemaphoreTake(out_mutex, portMAX_DELAY);
+  bool ok = sys_port_write_nb(0, (const unsigned char *)str, strlen(str));
+  xSemaphoreGive(out_mutex);
+  return ok;
 }
 
