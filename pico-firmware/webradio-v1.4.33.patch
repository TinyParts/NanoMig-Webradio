 }
 
+// like sys_port_write() but gives up instead of waiting when the core's buffer is full
+// (used for unsolicited messages that must never block when nobody reads the port)
+bool sys_port_write_nb(unsigned char port, const unsigned char *ptr, int len) {
+  if(len <= 0) return true;
+  if(sys_port_tx_free(port) < len) return false;
+  sys_port_begin(SPI_SYS_PORT_PUT);
+  mcu_hw_spi_tx_u08(port);
+  for(int i=0;i<len;i++)
+    mcu_hw_spi_tx_u08(ptr[i]);
+  mcu_hw_spi_end();
+  return true;
+}
+
+// writes as many bytes as currently fit into the core's (small, 15 byte) fifo and returns that number
+int sys_port_write_part(unsigned char port, const unsigned char *ptr, int len) {
+  if(len <= 0) return 0;
+  int room = sys_port_tx_free(port);
+  if(room <= 0) return 0;
+  if(room > len) room = len;
+  sys_port_begin(SPI_SYS_PORT_PUT);
+  mcu_hw_spi_tx_u08(port);
+  for(int i=0;i<room;i++)
+    mcu_hw_spi_tx_u08(ptr[i]);
+  mcu_hw_spi_end();
+  return room;
+}
